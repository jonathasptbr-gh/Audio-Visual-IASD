<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sem AppCompat: a UI inteira é o WebView. O tema só garante o fundo
         escuro (`@color/app_bg`, que espelha o token de fundo `bg` de
         assets/web/shared/tokens.css — sem os dois hífens da custom property,
         que num comentário XML são erro de sintaxe e reprovam o arquivo no
         aapt2) e nenhuma action bar, para não haver "flash" claro entre o
         splash e a carga do WebView — e para as barras
         do sistema não desenharem um preto diferente do corpo do app.

         ATENÇÃO (targetSdk 35): no Android 15+ o sistema força edge-to-edge e
         IGNORA statusBarColor/navigationBarColor — os dois itens abaixo só
         valem até o Android 14. Nas versões novas, o preto atrás das barras é
         o body da base web pintando o MESMO token `bg` por baixo delas; é por
         isso que a igualdade entre `@color/app_bg` e o token continua
         OBRIGATÓRIA mesmo com os itens ignorados: divergir reintroduziria a
         faixa de outro preto, agora só nos aparelhos novos.

         TEMA CLARO (v5.192): este é o tema ESCURO, que é o padrão de quem nunca
         escolheu nada e o único que o MANIFEST pode declarar — um recurso de
         XML é resolvido antes de existir JavaScript, então não há como
         perguntar ao Controle a tempo do primeiro quadro. Quem escolhe é a
         MainActivity, com um `setTheme(Theme.AvIasd.Claro)` ANTES do
         `super.onCreate` (é o único momento em que ele ainda vale: depois de a
         decor view existir, mudar o tema não repinta mais o windowBackground),
         a partir de uma cópia da escolha guardada em SharedPreferences. O
         preço, dito em vez de escondido: trocar de tema tem um lançamento de
         atraso no fundo do splash, e só nele. -->

    <style name="Theme.AvIasd" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- O MESMO tema, no claro. Ele NÃO entra no manifest: o app abre no escuro
         por padrão, e a MainActivity troca para cá antes do `super.onCreate`
         quando a preferência guardada disser "claro".
         `windowLightStatusBar` aqui é o par estático da bandeira que a Activity
         também vira em tempo de execução (para a troca ao vivo) — os dois
         existem porque cobrem momentos diferentes: este vale desde o primeiro
         quadro, aquele vale quando o operador troca com o app já aberto. -->
    <style name="Theme.AvIasd.Claro">
        <item name="android:windowBackground">@color/app_bg_claro</item>
        <item name="android:colorBackground">@color/app_bg_claro</item>
        <item name="android:statusBarColor">@color/app_bg_claro</item>
        <item name="android:navigationBarColor">@color/app_bg_claro</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- A Presentation (telão) é sempre preta e sem decoração nenhuma. -->
    <style name="Theme.AvIasd.Presentation" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>
</resources>
