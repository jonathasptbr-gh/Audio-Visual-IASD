    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Canto de 1 (não 0): a 24dp o quadrado reto fica duro ao lado do
         triângulo do play, que é desenhado com as pontas vivas mas estreitas. -->
